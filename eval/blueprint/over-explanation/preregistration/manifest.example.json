{
  "version": "bench-1-milestone-1",
  "arms": [
    {
      "id": "A0",
      "label": "baseline",
      "plugin_ref": "blueprint@v3.7.0",
      "evaluator": {},
      "description": "Untouched baseline plugin; no over-explanation treatment."
    },
    {
      "id": "A1",
      "label": "treatment",
      "plugin_ref": "blueprint@over-explanation",
      "evaluator": {
        "rule": "delete_or_merge"
      },
      "description": "Over-explanation fix: evaluator deletes or merges redundant proposition mentions."
    },
    {
      "id": "A3_fair",
      "label": "fair_brevity",
      "plugin_ref": "blueprint@brevity-fair",
      "evaluator": {
        "rule": "one_line_full_sentence"
      },
      "description": "Honest brevity control: tighten to one full grammatical sentence per claim, no word dropping."
    },
    {
      "id": "A2_placebo",
      "label": "placebo",
      "plugin_ref": "blueprint@placebo",
      "evaluator": {
        "rule": "noop_reformat"
      },
      "description": "Placebo: an extra evaluator pass that reformats without removing restatement."
    },
    {
      "id": "A3b_dumb",
      "label": "dumb_brevity",
      "plugin_ref": "blueprint@brevity-dumb",
      "evaluator": {
        "rule": "cut_30_percent"
      },
      "description": "'Be brief, cut 30%, keep it short.' Positive control for the grammaticality detector only; authorizes no ship clause. Also supplies U1f's length-strip leg (bench.u_arms)."
    }
  ],
