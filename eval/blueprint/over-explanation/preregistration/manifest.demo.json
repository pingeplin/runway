  "bench": {
    "u_arms": [
      "A0",
      "A1",
      "A2_placebo",
      "A3_fair",
      "A3b_dumb"
    ],
    "implementer_ref": "claude-sonnet-4-6",
    "preamble_template": "You are implementing a small Python project from the specification below.\n\nDeliverables, all inside the current working directory:\n  1. A Python module `{module}.py` at the top level, defining a callable\n     `{entrypoint}` that satisfies the specification.\n  2. A pytest test suite under `tests/`.\n\nRules:\n  - Work only inside the current working directory.\n  - Do not ask clarifying questions; proceed end to end.\n  - Commit your work with git as you go.\n\nSpecification:",
    "sandbox_test_cmd": [
      "{python}",
      "-m",
      "pytest",
      "-q",
      "-p",
      "no:cacheprovider"
    ],
