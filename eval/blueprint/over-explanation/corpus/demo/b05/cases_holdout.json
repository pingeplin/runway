      "expected": [
        "row 1: column 'flag' expected bool, got int"
      ]
    },
    {
      "label": "h_missing_mid",
      "args": [
        [
          {
            "city": "Oslo"
          },
          {}
        ],
        {
          "city": "str"
        }
      ],
      "expected": [
        "row 1: missing column 'city'"
      ]
    },
    {
      "label": "h_all_good",
      "args": [
        [
          {
            "n": 8
          }
        ],
        {
          "n": "int"
        }
      ],
      "expected": []
    }
  ]
}
